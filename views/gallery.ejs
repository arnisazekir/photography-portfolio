<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= segment.name %> — OutOfOrder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="site-header">
    <nav class="nav">
      <a href="/" class="nav-back">← Archive</a>
      <span class="nav-logo">OutOfOrder</span>
    </nav>
  </header>

  <section class="gallery-hero">
    <div class="gallery-hero-inner">
      <span class="gallery-vibe"><%= segment.vibe %></span>
      <h1 class="gallery-title"><%= segment.name %></h1>
      <p class="gallery-desc"><%= segment.description %></p>
    </div>
  </section>

  <div class="segment-nav">
    <% segments.forEach(function(s) { %>
      <a href="/gallery/<%= s.id %>"
         class="segment-nav-item<%= s.id === segment.id ? ' active' : '' %>">
        <%= s.name %>
      </a>
    <% }); %>
  </div>

  <!-- Grid: 3 equal columns, align-items:start so each cell is only as tall as its image -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:8px 8px 80px;align-items:start;">

    <% images.forEach(function(img, i) { %>
      <div onclick="openPhoto(this)" style="cursor:pointer;">
        <img
          src="<%= img.thumbPath || img.path %>"
          data-full="<%= img.cloudinaryUrl || img.thumbPath || img.path %>"
          alt="<%= segment.name %> <%= i+1 %>"
          style="width:100%;height:auto;display:block;">
      </div>
    <% }); %>

    <% if (images.length === 0) { %>
      <p style="color:#888;padding:40px;text-align:center;grid-column:1/-1;">No images in this gallery yet.</p>
    <% } %>
  </div>

  <footer class="site-footer">
    <p>OutOfOrder &mdash; Personal Visual Portfolio</p>
  </footer>

  <script src="/js/transitions.js"></script>
  <script>
    function openPhoto(container){
      var img = container.querySelector('img');
      document.getElementById('lb-img').src = img.getAttribute('data-full') || img.src;
      document.getElementById('lb').style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
    function closePhoto(){
      document.getElementById('lb').style.display = 'none';
      document.getElementById('lb-img').src = '';
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape') closePhoto();
    });
  </script>

  <!-- Lightbox: last child of body, position:fixed covers full viewport -->
  <div id="lb"
       onclick="if(event.target===this)closePhoto()"
       style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;background:rgba(0,0,0,0.95);">
    <!-- Image centred with transform — works in every browser -->
    <img id="lb-img" src="" alt=""
         style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
                max-width:90vw;max-height:90vh;width:auto;height:auto;object-fit:contain;display:block;">
    <!-- Close button -->
    <span onclick="closePhoto()"
          style="position:absolute;top:18px;right:26px;font-size:34px;line-height:1;
                 color:#fff;cursor:pointer;z-index:1;user-select:none;">✕</span>
  </div>

</body>
</html>
