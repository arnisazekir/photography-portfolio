<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= segment.name %> — OutOfOrder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v=5">
</head>
<body>

  <header class="site-header">
    <nav class="nav">
      <a href="/" class="nav-back">← Archive</a>
      <span class="nav-logo">OutOfOrder</span>
    </nav>
  </header>

  <section class="gallery-hero">
    <div class="gallery-hero-inner">
      <span class="gallery-vibe"><%= segment.vibe %></span>
      <h1 class="gallery-title"><%= segment.name %></h1>
      <p class="gallery-desc"><%= segment.description %></p>
    </div>
  </section>

  <div class="segment-nav">
    <% segments.forEach(function(s) { %>
      <a href="/gallery/<%= s.id %>"
         class="segment-nav-item<%= s.id === segment.id ? ' active' : '' %>">
        <%= s.name %>
      </a>
    <% }); %>
  </div>

  <!-- Full images, never cropped — src set directly, browser lazy-loads natively -->
  <main class="gallery-grid" id="gallery">
    <% if (images.length === 0) { %>
      <p class="empty-state">No images in this gallery yet.</p>
    <% } %>

    <% images.forEach(function(img, i) { %>
      <div class="gallery-item" data-index="<%= i %>" role="button" tabindex="0">
        <img
          src="<%= img.thumbPath || img.path %>"
          alt="<%= segment.name %> — <%= i + 1 %>"
          loading="lazy"
          class="gallery-img"
          draggable="false"
        >
      </div>
    <% }); %>
  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-spinner" id="lbSpinner"></div>
    <img id="lbImage" class="lightbox-img" src="" alt="">
    <button class="lightbox-close" id="lbClose" aria-label="Close">✕</button>
    <button class="lightbox-prev"  id="lbPrev"  aria-label="Previous">‹</button>
    <button class="lightbox-next"  id="lbNext"  aria-label="Next">›</button>
    <div class="lightbox-counter" id="lbCounter"></div>
  </div>

  <footer class="site-footer">
    <p>OutOfOrder &mdash; Personal Visual Portfolio</p>
  </footer>

  <script>
    window.GALLERY_FULLPATHS = <%- JSON.stringify(images.map(i => i.thumbPath || i.path)) %>;
  </script>
  <script src="/js/transitions.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
