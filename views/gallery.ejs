<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= segment.name %> — OutOfOrder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* ── Lightbox ─────────────────────────────────────────────── */
    #lb {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #000;
    }
    #lb.open { display: flex; align-items: center; justify-content: center; }

    #lb-img {
      display: block;
      max-width: 90vw;
      max-height: 90vh;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    /* Close */
    #lb-close {
      position: fixed; top: 20px; right: 24px;
      font-size: 28px; color: rgba(255,255,255,0.7);
      background: none; border: none; cursor: pointer;
      line-height: 1; z-index: 10000;
    }
    #lb-close:hover { color: #fff; }

    /* Arrows */
    #lb-prev, #lb-next {
      position: fixed; top: 50%; transform: translateY(-50%);
      font-size: 48px; color: rgba(255,255,255,0.5);
      background: none; border: none; cursor: pointer;
      z-index: 10000; padding: 0 16px; line-height: 1;
      transition: color 0.2s;
    }
    #lb-prev:hover, #lb-next:hover { color: #fff; }
    #lb-prev { left: 8px; }
    #lb-next { right: 8px; }

    /* Counter */
    #lb-counter {
      position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
      color: rgba(255,255,255,0.35); font-size: 12px;
      letter-spacing: 0.15em; pointer-events: none;
      font-family: var(--font);
    }
  </style>
</head>
<body>

  <header class="site-header">
    <nav class="nav">
      <a href="/" class="nav-back">← Archive</a>
      <span class="nav-logo">OutOfOrder</span>
    </nav>
  </header>

  <section class="gallery-hero">
    <div class="gallery-hero-inner">
      <span class="gallery-vibe"><%= segment.vibe %></span>
      <h1 class="gallery-title"><%= segment.name %></h1>
      <p class="gallery-desc"><%= segment.description %></p>
    </div>
  </section>

  <div class="segment-nav">
    <% segments.forEach(function(s) { %>
      <a href="/gallery/<%= s.id %>"
         class="segment-nav-item<%= s.id === segment.id ? ' active' : '' %>">
        <%= s.name %>
      </a>
    <% }); %>
  </div>

  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:8px 8px 80px;align-items:start;">
    <% images.forEach(function(img, i) { %>
      <div onclick="LB.open(<%= i %>)" style="cursor:pointer;">
        <img
          src="<%= img.thumbPath || img.path %>"
          data-full="<%= img.cloudinaryUrl || img.thumbPath || img.path %>"
          alt="<%= segment.name %> <%= i+1 %>"
          style="width:100%;height:auto;display:block;">
      </div>
    <% }); %>
    <% if (images.length === 0) { %>
      <p style="color:#888;padding:40px;text-align:center;grid-column:1/-1;">No images yet.</p>
    <% } %>
  </div>

  <footer class="site-footer">
    <p>OutOfOrder &mdash; Personal Visual Portfolio</p>
  </footer>

  <!-- Lightbox -->
  <div id="lb" onclick="if(event.target===this)LB.close()">
    <img id="lb-img" src="" alt="">
    <button id="lb-close" onclick="LB.close()">✕</button>
    <button id="lb-prev"  onclick="LB.prev()">‹</button>
    <button id="lb-next"  onclick="LB.next()">›</button>
    <div id="lb-counter"></div>
  </div>

  <script src="/js/transitions.js"></script>
  <script>
    var LB = (function () {
      var items   = Array.from(document.querySelectorAll('[data-full]'));
      var total   = items.length;
      var cur     = 0;
      var lb      = document.getElementById('lb');
      var lbImg   = document.getElementById('lb-img');
      var lbCount = document.getElementById('lb-counter');

      function show(i) {
        cur = i;
        // items[i] IS the <img> element — data-full is on the img itself
        var el       = items[i];
        var thumbSrc = el.src;
        var fullSrc  = el.getAttribute('data-full');

        // Show thumbnail immediately — already cached from the grid
        lbImg.src = thumbSrc;
        lbCount.textContent = (i + 1) + '  /  ' + total;

        // Load full-res in background, swap silently when ready
        if (fullSrc && fullSrc !== thumbSrc) {
          var hi = new Image();
          hi.onload = function () {
            if (cur === i) lbImg.src = fullSrc;
          };
          hi.src = fullSrc;
        }

        // Preload neighbours for fast arrow navigation
        if (i + 1 < total) new Image().src = items[i+1].getAttribute('data-full');
        if (i - 1 >= 0)    new Image().src = items[i-1].getAttribute('data-full');
      }

      return {
        open: function (i) {
          lb.className = 'open';
          document.body.style.overflow = 'hidden';
          show(i);
        },
        close: function () {
          lb.className = '';
          document.body.style.overflow = '';
          lbImg.classList.remove('visible');
          lbImg.src = '';
        },
        prev: function () { show((cur - 1 + total) % total); },
        next: function () { show((cur + 1) % total); }
      };
    })();

    document.addEventListener('keydown', function (e) {
      if (!document.getElementById('lb').classList.contains('open')) return;
      if (e.key === 'Escape')     LB.close();
      if (e.key === 'ArrowLeft')  LB.prev();
      if (e.key === 'ArrowRight') LB.next();
    });

    // Touch swipe
    var tx = null;
    document.getElementById('lb').addEventListener('touchstart', function (e) {
      tx = e.touches[0].clientX;
    }, { passive: true });
    document.getElementById('lb').addEventListener('touchend', function (e) {
      if (tx === null) return;
      var dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 50) { dx < 0 ? LB.next() : LB.prev(); }
      tx = null;
    }, { passive: true });
  </script>

</body>
</html>
