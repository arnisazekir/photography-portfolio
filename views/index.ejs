<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OutOfOrder — Personal Visual Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v=17">
</head>
<body>

  <header class="site-header">
    <nav class="nav">
      <span class="nav-logo">OutOfOrder</span>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title logo">OutO<span class="f-fix">f</span>Order</h1>
      <p class="hero-subtitle">personal visual portfolio</p>
      <div class="hero-scroll-hint">
        <span class="scroll-line"></span>
      </div>
    </div>
  </section>

  <section class="segments" id="segments">
    <div class="segments-grid">
      <% segments.forEach(function(seg) { %>
        <%
          const sorted  = seg.images.slice().sort((a,b) => a.order - b.order);
          const coverSrc = seg.coverImage ||
            (sorted.length > 0 ? (sorted[0].thumbPath || sorted[0].path) : '');
        %>
        <a href="/gallery/<%= seg.id %>" class="segment-card reveal-card">
          <div class="segment-card-inner">
            <div class="segment-preview<% if (!coverSrc) { %> segment-preview--empty<% } %>"
                 style="<% if (coverSrc) { %>background-image: url('<%= coverSrc %>')<% } %>">
            </div>
            <div class="segment-info">
              <span class="segment-vibe"><%= seg.vibe %></span>
              <h2 class="segment-name"><%= seg.name %></h2>
              <p class="segment-desc"><%= seg.description %></p>
              <span class="segment-count"><%= seg.images.length %> frames</span>
            </div>
          </div>
        </a>
      <% }); %>

      <% if (!segments || segments.length === 0) { %>
        <p class="empty-state">No segments yet.</p>
      <% } %>
    </div>
  </section>

  <footer class="site-footer">
    <p>OutOfOrder &mdash; Personal Visual Portfolio</p>
  </footer>

  <script src="/js/transitions.js"></script>
  <script src="/js/main.js?v=2"></script>
</body>
</html>
